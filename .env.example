# Copia este archivo como .env y completa. NUNCA subas .env al repo.

# --- Login facture.co (PLColab) ---
FACTURE_USER=usuario_facture
FACTURE_PASS=clave_facture
FACTURE_LOGIN_URL=https://plataforma.facture.co/plataforma/login

# --- Ruta a fe-tool (para importar sus funciones) ---
# Local: la copia de fe-tool en tu disco.
# Nube (GitHub Actions con submodule): ./fe-tool
FE_TOOL_PATH=../testap

# --- RNDC ---
# Endpoint del proceso 86. Opciones que entiende lib_rndc86.ENDPOINTS:
#   "Producción (rndcws)"  (por defecto)
RNDC_ENDPOINT=Producción (rndcws)

# --- Comportamiento ---
# Playwright en modo headless (1) o con ventana visible para depurar (0)
PLAYWRIGHT_HEADLESS=1
# Tope de facturas por corrida (0 = sin tope)
MAX_FACTURAS=0

# --- Correo del reporte (opcional; si se deja vacío, no se envía correo) ---
# Gmail: SMTP_USER=tu@gmail.com, SMTP_PASS=<contraseña de aplicación de 16 dígitos>
# (crear en https://myaccount.google.com/apppasswords con 2FA activo).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=destinatario@ejemplo.com
MAIL_FROM=
